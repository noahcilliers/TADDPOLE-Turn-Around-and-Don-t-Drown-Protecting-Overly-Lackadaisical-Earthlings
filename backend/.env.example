# Tiger Data connection string (Tiger Console -> your service -> Connect). Keep sslmode=require.
# TIGER_DB=... also works.
DATABASE_URL=postgres://tsdbadmin:CHANGE_ME@CHANGE_ME.tsdb.cloud.timescale.com:CHANGE_ME/tsdb?sslmode=require

# Domain pointed at the EC2 Elastic IP -> Caddy gets a TLS cert automatically. ":80" = HTTP only.
SITE_ADDRESS=:80

# Comma-separated frontend origins allowed by CORS ("*" for the hackathon).
CORS_ORIGINS=*

# Protects POST /admin/sensors/{id}/simulate. Empty = admin endpoints disabled.
ADMIN_TOKEN=

# Tuning (defaults shown). Lower these for a tub-of-water demo.
POLL_INTERVAL_S=1.0
CAUTION_CM=5
FLOODED_CM=15
RISE_RATE_CM_PER_MIN=2
RISE_WINDOW_S=60
MEDIAN_OF=3
HYSTERESIS_CM=2
SPIKE_HALF_WINDOW=3
SPIKE_SIGMAS=3
SPIKE_MIN_CM=1
STALE_AFTER_S=60
OFFLINE_AFTER_S=300
# Simulated/scripted depth scale; empty = FLOODED_CM / 30 (handoff profiles assume 10/30 cm)
SIM_DEPTH_SCALE=
GRAPH_PATH=data/camelback.graphml
# A flooded sensor closes every road segment within this many metres (not just its own block),
# and roads out to FLOOD_BUFFER_M cost progressively more, so detours swing wide of the water.
FLOOD_BLOCK_RADIUS_M=300
FLOOD_BUFFER_M=700

# Discord alerts: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL. Empty = off.
DISCORD_WEBHOOK_URL=
# Which transitions to post: flooded, reopened, caution, clear, offline
DISCORD_NOTIFY_ON=flooded,reopened
DISCORD_COOLDOWN_S=60
# Simulated sensors replay 24 h profiles and would post constantly; off by default.
DISCORD_INCLUDE_SIMULATED=false
# Ping on flooded alerts so phones get a push: everyone, here, or a role ID (right-click role -> Copy Role ID).
DISCORD_MENTION=
# Optional link from each alert to the live map.
DISCORD_APP_URL=

# Camera water check: before a sensor's status goes UP, grab a webcam photo and ask Gemini whether it's
# water. Not water (car, hand, box...) -> no alert. Empty key = off. Needs: pip install -r requirements-camera.txt
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Which webcam to use: 0 = first camera (often the laptop's built-in one), 1 = USB webcam, ...
# On EC2 (no webcam): the tunnel URL of scripts/camera_server.py, e.g. https://<random>.trycloudflare.com/snapshot.jpg
CAMERA=0
# Shared secret between scripts/camera_server.py (laptop) and the backend fetching from it. Same value on both.
CAMERA_TOKEN=
# Sensors the camera looks at (comma-separated)
CAMERA_SENSORS=water_tank_1
GEMINI_MODEL=gemini-3.5-flash
